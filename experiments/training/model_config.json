{
  "config_version": "rtlprobe-training-config-v1",
  "note": "Fixed settings for the single-lineage starter package. Not tuned. Freeze any change before a final held-out run.",
  "seeds": [0, 1, 2],
  "lgbm": {
    "objective": "lambdarank",
    "n_estimators": 200,
    "learning_rate": 0.05,
    "num_leaves": 15,
    "min_child_samples": 20,
    "subsample": 0.8,
    "subsample_freq": 1,
    "colsample_bytree": 0.8,
    "deterministic": true,
    "force_row_wise": true,
    "verbose": -1
  },
  "logreg": {
    "C": 1.0,
    "solver": "lbfgs",
    "max_iter": 5000,
    "penalty": "L2 (l1_ratio=0.0 on scikit-learn >= 1.8, else penalty='l2')",
    "class_weighting": "per-case sample weights: bug line(s) share 0.5, other lines share 0.5"
  },
  "mlp": {
    "hidden": [32, 16],
    "dropout": 0.1,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "epochs": 300,
    "optimizer": "Adam, full batch",
    "loss": "pairwise_softplus_within_case",
    "device": "cpu"
  }
}
