{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTLProbe pilot case",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "state",
    "automated_validation",
    "design_id",
    "proposal",
    "fingerprint",
    "track",
    "original",
    "mutants",
    "restored",
    "checks",
    "structural",
    "qualification",
    "prediction_agreement",
    "human_review",
    "ground_truth",
    "access",
    "cost",
    "mutation_key"
  ],
  "properties": {
    "validation_policy": {
      "enum": ["mutation-validation-v1", "mutation-validation-v2"]
    },
    "original_reuse": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["qualification_manifest_sha256"],
          "additionalProperties": false,
          "properties": {
            "qualification_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "schema_version": {
      "const": "pilot-2"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "validated_pending_review",
        "needs_review",
        "invalid",
        "unexposed",
        "infrastructure_error",
        "unsupported",
        "flaky"
      ]
    },
    "automated_validation": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "mutants": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "human_review": {
      "type": "object",
      "required": [
        "status",
        "reviewer",
        "decision"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "reviewer": {
          "type": "null"
        },
        "decision": {
          "type": "null"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["validation_policy"],
        "properties": {"validation_policy": {"const": "mutation-validation-v2"}}
      },
      "then": {
        "required": ["original_reuse"],
        "if": {"properties": {"automated_validation": {"const": "pass"}}},
        "then": {
          "properties": {
            "mutants": {"minItems": 2}
          }
        }
      },
      "else": {"not": {"required": ["original_reuse"]}}
    }
  ]
}
