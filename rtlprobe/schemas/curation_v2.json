{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTLProbe curation event (curator-only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "from_state", "to_state", "reviewer", "human_review_record", "human_review_sha256", "case_manifest_sha256", "validation_record", "validation_sha256", "policy", "previous_record_hashes", "recorded_at"],
  "properties": {
    "schema_version": {"const": "curation-2"},
    "case_id": {"type": "string", "minLength": 1},
    "from_state": {"enum": ["validated_pending_review", "accepted_auto"]},
    "to_state": {"enum": ["accepted_core", "accepted_auto", "rejected"]},
    "reviewer": {"type": ["string", "null"], "minLength": 1},
    "human_review_record": {"type": ["string", "null"], "minLength": 1},
    "human_review_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "case_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validation_record": {"type": "string", "minLength": 1},
    "validation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{12}Z$"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["rule", "first_n", "fraction", "pair", "rank", "hold_reasons"],
      "properties": {
        "rule": {"enum": ["first_n_human_then_auto", "human_review"]},
        "first_n": {"type": "integer", "minimum": 0},
        "fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "pair": {
          "type": "object", "additionalProperties": false, "required": ["design_id", "operator_id"],
          "properties": {"design_id": {"type": "string", "minLength": 1}, "operator_id": {"type": "string", "minLength": 1}}
        },
        "rank": {"type": "integer", "minimum": 1},
        "hold_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "previous_record_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["index_sha256", "label_sha256", "review_sha256"],
      "properties": {
        "index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "label_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "acceptance_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "from_state": {"const": "validated_pending_review"}, "to_state": {"const": "accepted_auto"},
        "reviewer": {"type": "null"}, "human_review_record": {"type": "null"}, "human_review_sha256": {"type": "null"},
        "policy": {"properties": {"rule": {"const": "first_n_human_then_auto"}, "hold_reasons": {"maxItems": 0}}}
      }
    },
    {
      "properties": {
        "to_state": {"enum": ["accepted_core", "rejected"]}, "reviewer": {"type": "string"},
        "human_review_record": {"type": "string"}, "human_review_sha256": {"type": "string"},
        "policy": {"properties": {"rule": {"const": "human_review"}}}
      }
    }
  ]
}
